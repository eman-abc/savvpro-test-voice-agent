# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=dev                      # dev | test | prod
DATABASE_URL=sqlite:///./data/clinic.db   # or postgresql://user:pass@host:5432/dbname
JWT_SECRET=dev-only-secret-change-me      # prod requires 24+ random characters
COOKIE_SECURE=false              # true when served over https
STAFF_USERNAME=reception
STAFF_PASSWORD=demo-staff-2026   # change it, and set DEMO_MODE=false, for anything real
DEMO_MODE=true                   # seeds fake data and shows sign-in hints in the UI
RATE_LIMIT_PER_MINUTE=120
CALL_IDLE_MINUTES=30
SESSION_RETENTION_HOURS=48
LOG_LEVEL=INFO

# --- operations ---
USE_MIGRATIONS=false             # true = run Alembic at start-up (the Docker image sets this)
TRUSTED_PROXY_COUNT=0            # proxies in front that append to X-Forwarded-For (Render: 1)
METRICS_TOKEN=                   # set to expose GET /metrics (Prometheus) with a bearer token
SENTRY_DSN=                      # optional error reporting; also: pip install sentry-sdk
REMINDERS_ENABLED=false          # background reminders (LogNotifier by default; plug in an SMS sender)
REMINDER_HOURS=24
VERIFY_LOCK_FAILURES=5           # failed identity checks per name before it is locked
VERIFY_LOCK_MINUTES=15

# --- WhatsApp (Meta Cloud API) and speech: see docs/WHATSAPP_SETUP.md ---
WHATSAPP_VERIFY_TOKEN=           # a string you choose; paste the same into Meta's webhook settings
WHATSAPP_APP_SECRET=             # Meta app secret: every webhook call is signed with it
WHATSAPP_ACCESS_TOKEN=           # System User token (the temporary one expires in 24 hours)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_NUMBERS=        # your number as digits, comma-separated; others are ignored
WHATSAPP_TEMPLATE_NAME=          # approved template for when the 24-hour window is closed
DEMO_WHATSAPP_NUMBER=            # links a demo patient to YOUR number at start-up
STT_PROVIDER=none                # none | deepgram | fake
DEEPGRAM_API_KEY=
ASR_MIN_CONFIDENCE=0.55

# --- knowledge layer and agent (all optional; see README "Knowledge layer" and "Agent brain") ---
ELASTICSEARCH_URL=                # e.g. http://localhost:9200  (empty = the app uses its own BM25)
ES_URDU_ANALYZER=urdu_custom      # standard | arabic | persian | urdu_custom
NEO4J_URI=                        # e.g. bolt://localhost:7687  (empty = in-memory graph)
NEO4J_PASSWORD=
DENSE_ENABLED=false               # needs: pip install -r backend/requirements-dense.txt
BRAIN=rules                       # rules | agent
LLM_PROVIDER=none                 # none | groq | openai | ollama
LLM_MODEL=
LLM_API_KEY=
